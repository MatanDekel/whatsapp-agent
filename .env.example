# Claude
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
TZ_NAME=Asia/Jerusalem
ENABLE_WEB_SEARCH=true

# WhatsApp Cloud API (Meta)
WA_TOKEN=                 # System User permanent token
WA_PHONE_NUMBER_ID=       # ה-ID של מספר הבוט
WA_APP_SECRET=            # App Secret לאימות חתימה
WA_VERIFY_TOKEN=          # מחרוזת שתבחר, לאימות ה-webhook
WA_TEMPLATE_NAME=agent_update
WA_TEMPLATE_LANG=he
GRAPH_VERSION=v21.0

# אייפון / Cron
CRON_SECRET=              # Vercel שולח אותה אוטומטית ל-cron

# Upstash Redis (נוצר אוטומטית אם מחברים דרך Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# תזכורות מתוזמנות — Upstash QStash (נוצר אוטומטית דרך Vercel Marketplace)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_URL=https://<הפרויקט>.vercel.app
EVENT_REMINDER_MINUTES=30   # תזכורת לפני כל אירוע ביומן; 0 = כבוי

# משתמשים — כל אחד סוכן נפרד (JSON בשורה אחת)
# phone: בלי + ובלי 0 | token: לקיצורי האייפון של אותו משתמש | gender: f / m
# family: שם קבוצה משותף | shareSchedule: true = בני המשפחה יכולים לראות את הלו"ז שלי
USERS=[{"id":"me","name":"השם שלי","phone":"9725XXXXXXXX","token":"...","gender":"f","family":"home","shareSchedule":true}]

# יומן Google (Google Cloud → Clients → Web application)
# Redirect URI: https://<הפרויקט>.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
